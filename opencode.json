{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "build": {
      "mode": "primary",
      "model": "ollama/qwen3.5:9b",
      "prompt": "{file:./prompts/build.txt}",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "ollama/qwen2.5-coder:7b",
      "prompt": "{file:./prompts/plan.txt}",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  }
}
